        },
        "description": "E-mail sem formato válido e senha curta. Esperado: mensagem de erro."
      }
    },
    {
      "name": "CT06 (extra) - Requisição sem apikey",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status HTTP 401 (sem chave de API)', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test('Não retorna access_token', function () {",
              "    pm.expect(pm.response.text()).to.not.include('access_token');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
