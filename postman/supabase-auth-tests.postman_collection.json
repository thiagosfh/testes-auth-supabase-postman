        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"emailinvalido\",\n  \"password\": \"123\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/auth/v1/token?grant_type=password",
          "host": ["{{base_url}}"],
