              "});",
              "",
              "pm.test('Retorna mensagem de erro', function () {",
              "    const msg = json.msg || json.error_description || json.message;",
              "    pm.expect(msg).to.be.a('string').and.not.empty;",
              "    console.log('Mensagem recebida:', msg);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey", "value": "{{api_key}}" },
          { "key": "Authorization", "value": "Bearer {{api_key}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"naoexiste.teste@email.com\",\n  \"password\": \"Qualquer123\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/auth/v1/token?grant_type=password",
          "host": ["{{base_url}}"],
          "path": ["auth", "v1", "token"],
          "query": [{ "key": "grant_type", "value": "password" }]
        },
        "description": "E-mail que não está cadastrado. Esperado: acesso negado."
      }
    },
