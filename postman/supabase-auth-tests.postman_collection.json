        "url": {
          "raw": "{{base_url}}/auth/v1/token?grant_type=password",
          "host": ["{{base_url}}"],
          "path": ["auth", "v1", "token"],
          "query": [{ "key": "grant_type", "value": "password" }]
        },
        "description": "E-mail e senha vazios. Esperado: erro de validação."
      }
    },
    {
      "name": "CT05 - Credenciais inválidas (e-mail mal formatado)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status HTTP 4xx', function () {",
              "    pm.expect(pm.response.code).to.be.within(400, 499);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('Não retorna access_token', function () {",
              "    pm.expect(json).to.not.have.property('access_token');",
              "});",
              "",
